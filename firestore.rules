rules_version = '2';

// Shared Firestore rules for the Librebook Android app and web app.
// Keep this file aligned in both project directories and deploy the same
// ruleset for both clients so behavior stays consistent across platforms.

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isVerified() {
      return signedIn() && (
        request.auth.token.get('email_verified', false) == true ||
        isAdmin()
      );
    }

    function uid() {
      return request.auth.uid;
    }

    function ownsExisting(field) {
      return signedIn() && resource.data[field] == uid();
    }

    function ownsIncoming(field) {
      return signedIn() && request.resource.data[field] == uid();
    }

    function ownsIncomingAny(primary, fallback) {
      return signedIn() && (
        request.resource.data[primary] == uid() ||
        request.resource.data[fallback] == uid()
      );
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isPublicFeedPost() {
      return !('visibility' in resource.data) ||
        resource.data.visibility == 'public' ||
        resource.data.privacy == 'public';
    }

    function validCounterDelta(field, minDelta, maxDelta) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return before is int &&
        after is int &&
        after - before >= minDelta &&
        after - before <= maxDelta;
    }

    function validExistingCounterDelta(field, minDelta, maxDelta) {
      return request.resource.data[field] is int &&
        resource.data[field] is int &&
        request.resource.data[field] - resource.data[field] >= minDelta &&
        request.resource.data[field] - resource.data[field] <= maxDelta;
    }

    function isBookAuthor(bookId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/books/$(bookId)) &&
        canEditBookData(get(/databases/$(database)/documents/books/$(bookId)).data);
    }

    function isPublishedBook(bookId) {
      return exists(/databases/$(database)/documents/books/$(bookId)) &&
        get(/databases/$(database)/documents/books/$(bookId)).data.get('status', null) == 'published';
    }

    function canEditBookAfter(bookId) {
      return signedIn() &&
        existsAfter(/databases/$(database)/documents/books/$(bookId)) &&
        canEditBookData(
          getAfter(/databases/$(database)/documents/books/$(bookId)).data
        );
    }

    function canEditBookData(data) {
      return signedIn() && (
        data.authorId == uid() ||
        (
          hasAcceptedCollaboration(data) &&
          data.authorIds is list &&
          uid() in data.authorIds
        )
      );
    }

    function canReadBookData(data) {
      return isAdmin() ||
        data.get('source', null) == 'archive' ||
        data.get('status', null) == 'published' ||
        signedIn();
    }

    // Helper functions
    function hasAcceptedCollaboration(data) {
      return ('collaborationStatus' in data) &&
        data.collaborationStatus == 'accepted';
    }

    function isPrimaryBookAuthorData(data) {
      return signedIn() && data.authorId == uid();
    }

    function validCollaborationInvite(data) {
      return !('collaboratorId' in data) ||
        !('collaborationStatus' in data) ||
        data.collaborationStatus == null ||
        data.collaborationStatus == 'declined' ||
        (
          data.collaborationStatus == 'pending' &&
          data.collaboratorId is string &&
          data.collaboratorId != uid() &&
          data.authorIds is list &&
          data.authorIds.size() == 1 &&
          uid() in data.authorIds &&
          exists(/databases/$(database)/documents/follows/$(uid() + '_' + data.collaboratorId))
        );
    }

    function validCollaborationResponse() {
      return signedIn() &&
        resource.data.collaborationStatus == 'pending' &&
        resource.data.collaboratorId == uid() &&
        request.resource.data.collaboratorId == resource.data.collaboratorId &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'collaborationStatus',
          'collaborationRespondedAt',
          'authorIds',
          'updatedAt'
        ]) &&
        (
          request.resource.data.collaborationStatus == 'declined' ||
          (
            request.resource.data.collaborationStatus == 'accepted' &&
            request.resource.data.authorIds is list &&
            resource.data.authorId in request.resource.data.authorIds &&
            resource.data.collaboratorId in request.resource.data.authorIds
          )
        );
    }

    function validCollaborationRemoval() {
      return signedIn() &&
        resource.data.collaborationStatus in ['pending', 'accepted'] &&
        (
          resource.data.authorId == uid() ||
          (
            hasAcceptedCollaboration(resource.data) &&
            resource.data.collaboratorId == uid()
          )
        ) &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.authorIds is list &&
        request.resource.data.authorIds.size() == 1 &&
        resource.data.authorId in request.resource.data.authorIds &&
        request.resource.data.authors is list &&
        request.resource.data.authors.size() == 1 &&
        request.resource.data.collaborationStatus == null &&
        request.resource.data.collaboratorId == null &&
        request.resource.data.collaboratorName == null &&
        request.resource.data.collaboratorPhotoURL == null &&
        (
          !hasAcceptedCollaboration(resource.data) ||
          (
            request.resource.data.collaborationRemovedBy == uid() &&
            request.resource.data.collaborationRemovedAt is int &&
            request.resource.data.removedCollaboratorId == resource.data.collaboratorId
          )
        );
    }

    function validPrimaryBookUpdate() {
      return signedIn() &&
        isPrimaryBookAuthorData(resource.data) &&
        !hasAcceptedCollaboration(resource.data) &&
        validLeafFields(request.resource.data) &&
        request.resource.data.authorId == resource.data.authorId &&
        validCollaborationInvite(request.resource.data);
    }

    // Helper functions
    function validAcceptedCollaborationEdit() {
      return signedIn() &&
        resource.data.collaborationStatus == 'accepted' &&
        canEditBookData(resource.data) &&
        validLeafFields(request.resource.data) &&
        request.resource.data.status != 'deleted' &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.authors == resource.data.authors &&
        request.resource.data.authorIds == resource.data.authorIds &&
        request.resource.data.collaborationStatus == resource.data.collaborationStatus &&
        request.resource.data.collaboratorId == resource.data.collaboratorId &&
        request.resource.data.get('collaboratorName', null) == resource.data.get('collaboratorName', null) &&
        request.resource.data.get('collaboratorPhotoURL', null) == resource.data.get('collaboratorPhotoURL', null);
    }

    function validCommentAudioFields(data) {
      return (!('audioUrl' in data) || data.audioUrl is string) &&
        (!('audioObjectKey' in data) || data.audioObjectKey is string) &&
        (!('audioDurationMs' in data) || data.audioDurationMs is int) &&
        (!('audioMimeType' in data) || data.audioMimeType is string) &&
        (!('audioSizeBytes' in data) || data.audioSizeBytes is int);
    }

    function validLeafFields(data) {
      let leaves = data.get('leaves', []);
      return leaves is list &&
        leaves.size() <= 20 &&
        data.get('leafCount', leaves.size()) == leaves.size() &&
        data.get('hasLeaves', leaves.size() > 0) == (leaves.size() > 0) &&
        (
          data.get('leafUpdatedAt', null) == null ||
          data.get('leafUpdatedAt', null) is int
        );
    }

    function allowsLegacyEmbeddedFeedCommentMutation() {
      return signedIn() &&
        request.resource.data.comments is list &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'comments',
          'commentCount',
          'updatedAt'
        ]) &&
        (
          !('commentCount' in request.resource.data) ||
          !('commentCount' in resource.data) ||
          validCounterDelta('commentCount', -1, 1)
        );
    }

    function validSelfUserUpdate(userId) {
      return signedIn() &&
        userId == uid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username',
          'displayName',
          'photoURL',
          'coverPhotoURL',
          'bio',
          'penName',
          'instagramHandle',
          'privacyLevel',
          'profileVisibility',
          'pinnedWorks',
          'preferredLanguage',
          'lastLogin',
          'searchTerms'
        ]) &&
        (
          isVerified() ||
          onlyChanges(['lastLogin'])
        ) &&
        request.resource.data.get('id', null) == resource.data.get('id', null) &&
        request.resource.data.get('email', null) == resource.data.get('email', null) &&
        request.resource.data.get('isDeactivated', null) == resource.data.get('isDeactivated', null) &&
        request.resource.data.get('totalPoints', null) == resource.data.get('totalPoints', null) &&
        request.resource.data.get('tier', null) == resource.data.get('tier', null) &&
        request.resource.data.get('authorPoints', null) == resource.data.get('authorPoints', null) &&
        request.resource.data.get('authorRank', null) == resource.data.get('authorRank', null) &&
        request.resource.data.get('readerPoints', null) == resource.data.get('readerPoints', null) &&
        request.resource.data.get('readerRank', null) == resource.data.get('readerRank', null) &&
        request.resource.data.get('booksReadCount', null) == resource.data.get('booksReadCount', null) &&
        request.resource.data.get('commentsPostedCount', null) == resource.data.get('commentsPostedCount', null);
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      // Private account data lives in users/{id}/private/account, never here.
      allow create: if signedIn() && userId == uid() &&
        !request.resource.data.keys().hasAny([
          'email', 'readingHistory', 'savedBooks', 'bookmarks',
          'notificationSettings', 'readingProgress', 'fcmTokens',
          'fcmTokenRegistry', 'fcmToken', 'newsletterOptOut', 'lastPlatform'
        ]);
      allow update: if signedIn() && (
        validSelfUserUpdate(userId) ||
        isAdmin() ||
        (
          isVerified() &&
          onlyChanges(['followersCount']) &&
          validExistingCounterDelta('followersCount', -1, 1)
        ) ||
        (
          isVerified() &&
          onlyChanges(['followingCount']) &&
          validExistingCounterDelta('followingCount', -1, 1)
        )
      );
      allow delete: if isAdmin() || (isVerified() && userId == uid());

      match /private/{docId} {
        allow read, write: if signedIn() && (userId == uid() || isAdmin());
      }
    }

    // Follows collection
    match /follows/{followId} {
      allow read: if true;
      allow create: if isVerified() && ownsIncoming('followerId') &&
        request.resource.data.followingId is string &&
        request.resource.data.followingId != uid();
      allow update: if false;
      allow delete: if (isVerified() && ownsExisting('followerId')) || isAdmin();
    }

    // UPI "support the author": no money moves through the app. Authors store
    // their UPI ID; readers record an "I supported" claim that the author can
    // verify. Notifications for claims are written by Cloud Functions.
    function validUpiId(value) {
      return value is string &&
        value.matches('^[a-zA-Z0-9._\\-]{2,64}@[a-zA-Z][a-zA-Z0-9.\\-]{1,31}$');
    }

    match /author_support/{authorId} {
      allow read: if signedIn();
      allow create, update: if isVerified() && authorId == uid() &&
        request.resource.data.keys().hasOnly(['upiId', 'enabled', 'message', 'updatedAt']) &&
        validUpiId(request.resource.data.upiId) &&
        request.resource.data.enabled is bool &&
        (
          !('message' in request.resource.data) ||
          (request.resource.data.message is string && request.resource.data.message.size() <= 140)
        );
      allow delete: if signedIn() && authorId == uid();
    }

    match /support_claims/{claimId} {
      allow read: if signedIn();
      allow create: if isVerified() &&
        ownsIncoming('supporterId') &&
        request.resource.data.authorId is string &&
        request.resource.data.authorId != uid() &&
        claimId == request.resource.data.authorId + '_' + uid() &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.supporterName is string &&
        request.resource.data.supporterName.size() > 0 &&
        request.resource.data.supporterName.size() <= 80 &&
        request.resource.data.keys().hasOnly([
          'authorId', 'supporterId', 'supporterName', 'supporterPhotoURL',
          'status', 'utr', 'amount', 'createdAt', 'updatedAt'
        ]);
      allow update: if isVerified() && (
        (
          ownsExisting('supporterId') &&
          resource.data.status == 'claimed' &&
          request.resource.data.status == 'claimed' &&
          onlyChanges(['supporterName', 'supporterPhotoURL', 'utr', 'amount', 'updatedAt'])
        ) ||
        (
          ownsExisting('authorId') &&
          request.resource.data.status in ['claimed', 'verified', 'hidden'] &&
          onlyChanges(['status', 'verifiedAt', 'updatedAt'])
        )
      );
      allow delete: if signedIn() && (
        ownsExisting('supporterId') || ownsExisting('authorId') || isAdmin()
      );
    }

    // Social feed posts
    match /feed/{postId} {
      allow read: if isPublicFeedPost() || ownsExisting('userId') || isAdmin();
      allow create: if isVerified() && ownsIncoming('userId');
      allow update: if isVerified() && (
        ownsExisting('userId') ||
        isAdmin() ||
        (
          onlyChanges(['bookId', 'bookTitle', 'chapterId', 'chapterTitle']) &&
          isBookAuthor(resource.data.bookId) &&
          isBookAuthor(request.resource.data.bookId)
        ) ||
        (
          onlyChanges(['likes']) &&
          request.resource.data.likes is list
        ) ||
        (
          onlyChanges(['likes', 'likesCount']) &&
          request.resource.data.likes is list &&
          validCounterDelta('likesCount', -1, 1)
        ) ||
        (
          onlyChanges(['commentCount']) &&
          validCounterDelta('commentCount', -1, 1)
        ) ||
        allowsLegacyEmbeddedFeedCommentMutation()
      );
      allow delete: if (isVerified() && ownsExisting('userId')) || isAdmin();
    }

    // Comments for books or feed posts
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isVerified() && ownsIncoming('userId') &&
        validCommentAudioFields(request.resource.data) &&
        (
          request.resource.data.bookId is string ||
          request.resource.data.bookId is int ||
          request.resource.data.feedPostId is string
        );
      allow update: if isVerified() && (
        (ownsExisting('userId') && validCommentAudioFields(request.resource.data)) ||
        isAdmin() ||
        (
          onlyChanges(['bookId', 'bookTitle', 'chapterId', 'chapterTitle', 'chapterIndex']) &&
          isBookAuthor(resource.data.bookId) &&
          isBookAuthor(request.resource.data.bookId)
        ) ||
        (
          onlyChanges(['likes']) &&
          request.resource.data.likes is list
        ) ||
        (
          onlyChanges(['likes', 'likesCount']) &&
          request.resource.data.likes is list &&
          validCounterDelta('likesCount', -1, 1)
        ) ||
        (
          onlyChanges(['replies']) &&
          request.resource.data.replies is list
        ) ||
        (
          onlyChanges(['replies', 'repliesCount']) &&
          request.resource.data.replies is list &&
          validCounterDelta('repliesCount', -1, 1)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isHighlighted',
            'highlightedAt',
            'highlightedByUserId'
          ]) &&
          request.resource.data.bookId is string &&
          request.resource.data.highlightedByUserId == uid() &&
          isBookAuthor(request.resource.data.bookId)
        )
      );
      allow delete: if (isVerified() && ownsExisting('userId')) || isAdmin();
    }

    // Books and their sub-collections (schema 2).
    // The canonical book document and every chapter subcollection are written
    // only by the Admin SDK inside the chapterCommand callable function.
    match /books/{bookId} {
      allow read: if canReadBookData(resource.data);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (
          onlyChanges(['viewCount']) &&
          validCounterDelta('viewCount', 0, 1)
        );

      // Private author drafts: author, accepted collaborators and admins only.
      match /authorChapters/{chapterId} {
        allow read: if isAdmin() || isBookAuthor(bookId);
        allow write: if false;

        // Revision history follows the private draft.
        match /revisions/{revisionId} {
          allow read: if isAdmin() || isBookAuthor(bookId);
          allow write: if false;
        }
      }

      // Server-only bookkeeping (author state, receipts, transfers).
      match /authorState/{stateId} {
        allow read: if isAdmin() || isBookAuthor(bookId);
        allow write: if false;
      }
      match /commandReceipts/{receiptId} {
        allow read, write: if false;
      }
      match /chapterTransfers/{transferId} {
        allow read, write: if false;
      }

      // Sub-collection for tracking unique views
      match /views/{viewerKey} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['viewerKey', 'createdAt']) || 
                         request.resource.data.keys().hasOnly(['timestamp', 'viewerId', 'isGuest', 'bookId']) ||
                         (
                           request.resource.data.keys().hasOnly([
                             'viewerKey',
                             'chapterKey',
                             'chapterIndex',
                             'chapterId',
                             'createdAt'
                           ]) &&
                           request.resource.data.viewerKey is string &&
                           request.resource.data.chapterKey is string &&
                           request.resource.data.chapterIndex is int &&
                           (
                             !request.resource.data.keys().hasAny(['chapterId']) ||
                             request.resource.data.chapterId is string
                           )
                         );
      }

      // Public table of contents: lightweight metadata, no chapter bodies.
      match /chapterDirectory/{chapterId} {
        allow read: if isPublishedBook(bookId) || isBookAuthor(bookId) || isAdmin();
        allow write: if false;
      }

      // Public chapter bodies, loaded lazily per chapter.
      match /chapters/{chapterId} {
        allow read: if isPublishedBook(bookId) || isBookAuthor(bookId) || isAdmin();
        allow write: if false;
      }

      // Edit leases are issued and released by chapterCommand only.
      match /chapterLocks/{lockId} {
        allow read: if isAdmin() || isBookAuthor(bookId);
        allow write: if false;
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      // Allow creation only if actor is the signed-in user and payload is valid
      allow create: if isVerified() &&
        (
          isAdmin() ||
          request.resource.data.actorId == uid()
        ) &&
        request.resource.data.userId != uid() && // Prevent self-notifications
        request.resource.data.type in [
          'follow', 'follower', 'post_like', 'feed_comment', 'feed_reply',
          'book_comment', 'book_review', 'book_reply', 'like', 'comment', 'reply',
          'message', 'collaboration_request', 'collaboration_accepted',
          'collaboration_removed', 'mention', 'published', 'chapter_update',
          'feedPost', 'new_creation', 'testimonial', 'groupMessage'
        ];
      allow update: if signedIn() &&
        (isAdmin() || resource.data.userId == uid()) &&
        onlyChanges(['isRead']);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Writes must go through Cloud Functions
    }

    // Author Interviews
    match /authorInterviews/{interviewId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // Reports for abuse/errors
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn() && (
        request.resource.data.reporterId == uid() ||
        request.resource.data.userId == uid()
      );
      allow update, delete: if isAdmin();
    }

    // User bookmarks/library
    match /bookmarks/{bookmarkId} {
      allow read: if ownsExisting('userId') || isAdmin();
      allow create: if (isVerified() && ownsIncoming('userId')) || isAdmin();
      allow update, delete: if (isVerified() && ownsExisting('userId')) || isAdmin();
    }

    // Testimonies written on an author's profile. The block was dropped from this file
    // earlier, which denied every read and write. Same semantics as the original rule,
    // plus the profile author may pin/hide (the only fields they may change).
    match /testimonies/{testimonyId} {
      allow read: if true;
      allow create: if signedIn() && ownsIncoming('userId');
      allow update: if signedIn() && (
        ownsExisting('userId') ||
        (
          resource.data.authorId == uid() &&
          onlyChanges(['isPinned', 'isHidden'])
        )
      );
      allow delete: if signedIn() && (
        ownsExisting('userId') ||
        resource.data.authorId == uid() ||
        isAdmin()
      );
    }

    // Private Messaging
    match /conversations/{conversationId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || uid() in resource.data.participants));
      allow create: if isAdmin() || (isVerified() && uid() in request.resource.data.participants);
      allow update: if signedIn() &&
        (
          isAdmin() ||
          (
            isVerified() &&
            uid() in resource.data.participants &&
            uid() in request.resource.data.participants
          )
        );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (
            signedIn() &&
            uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          );
        allow create: if isAdmin() ||
          (
            isVerified() &&
            ownsIncoming('senderId') &&
            uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          );
        allow update: if isAdmin() ||
          (
            signedIn() &&
            uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
            onlyChanges(['deletedFor']) &&
            request.resource.data.deletedFor is list &&
            request.resource.data.deletedFor.hasAll(resource.data.get('deletedFor', [])) &&
            uid() in request.resource.data.deletedFor
          ) ||
          // Read receipts: a participant may add themselves to readBy (never remove anyone).
          (
            signedIn() &&
            uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
            onlyChanges(['readBy']) &&
            request.resource.data.readBy is list &&
            request.resource.data.readBy.hasAll(resource.data.get('readBy', [])) &&
            uid() in request.resource.data.readBy
          );
        allow delete: if isAdmin() ||
          (
            isVerified() &&
            ownsExisting('senderId') &&
            uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          );
      }
    }

    // Global settings
    match /settings/{settingId} {
      allow read: if settingId != 'keys';
      allow write: if isAdmin();
    }

    match /settings/keys {
      allow read, write: if isAdmin();
    }

    // Leaderboards snapshot documents
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Home banners
    match /home-banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Canonical writer topic catalogue. Maintained by Cloud Functions only.
    match /topic-tags/{tagId} {
      allow read: if true;
      allow write: if false;
    }

    // Daily topics
    match /daily-topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Feed questions
    match /feed-questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Book recommendations / Archive votes
    match /recommendations/{recommendationId} {
      allow read: if true;
      allow create, update: if isVerified() &&
        request.resource.data.userId == uid() &&
        recommendationId == uid() + '_' + request.resource.data.bookId &&
        request.resource.data.type in ['up', 'down'];
      allow delete: if (isVerified() && resource.data.userId == uid()) || isAdmin();
    }

    // Public Internet Archive book details (title, cover), written by Cloud
    // Functions. Without a read rule saved and recommended Archive books
    // could not show their details in either app.
    match /books_metadata/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /book_stats/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // IA Upvotes cache
    match /ia_upvotes/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gamification history
    match /points_history/{historyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Book collections
    match /collections/{collectionId} {
      function validCollection(data) {
        return data.keys().hasOnly([
          'ownerId', 'title', 'description', 'bookCount', 'coverBookIds',
          'coverBooks', 'createdAt', 'updatedAt'
        ]) &&
          data.ownerId is string && data.ownerId.size() > 0 &&
          data.title is string && data.title == data.title.trim() &&
          data.title.size() > 0 && data.title.size() <= 60 &&
          data.description is string && data.description.size() <= 300 &&
          data.bookCount is int && data.bookCount >= 0 && data.bookCount <= 200 &&
          data.coverBookIds is list && data.coverBookIds.size() <= 4 &&
          data.coverBooks is list && data.coverBooks.size() <= 4 &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      function validMembership(data, bookId) {
        return data.keys().hasOnly(['bookId', 'position', 'addedAt']) &&
          data.bookId is string && data.bookId == bookId &&
          data.position is int && data.position >= 0 && data.position < 200 &&
          data.addedAt is timestamp;
      }

      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == uid() &&
        validCollection(request.resource.data);
      allow update: if signedIn() && resource.data.ownerId == uid() &&
        request.resource.data.ownerId == resource.data.ownerId &&
        validCollection(request.resource.data);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());

      match /books/{bookId} {
        allow read: if true;
        allow create, update: if signedIn() &&
          get(/databases/$(database)/documents/collections/$(collectionId)).data.ownerId == uid() &&
          validMembership(request.resource.data, bookId);
        allow delete: if isAdmin() || (signedIn() &&
          get(/databases/$(database)/documents/collections/$(collectionId)).data.ownerId == uid());
      }
    }

    // Mail collection for Firebase Trigger Email extension
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    // Admin tooling lists private account documents with collection group queries
    // (newsletter recipients, notification targeting). Owners still read their own
    // document through the users/{userId}/private rule above.
    match /{path=**}/private/{docId} {
      allow read: if isAdmin();
    }

    // NO CATCH-ALL READ. Access must be explicit per collection.
  }
}

